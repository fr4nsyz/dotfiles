#!/usr/bin/env bash

# ============================================================
#  IRIS // violet glass status rail
#  sketchybar theme
# ============================================================

export PLUGIN_DIR="$HOME/.config/sketchybar/plugins"
export FONT="BlexMono Nerd Font"

# --- Iris palette --------------------------------------------
export BG=0xff14101c   # deep violet-black glass
export FG=0xffcbb6ff   # soft lavender (values)
export ICON=0xff9a80d0 # mid violet (icons)
export DIM=0xff6a5b8f  # muted violet (separators / labels)
export WARN=0xffe6a94d # warm amber (alerts)

# --- Bar -----------------------------------------------------
sketchybar --bar \
  height=34 \
  position=top \
  color=$BG \
  border_width=1 \
  border_color=0xff2a2140 \
  corner_radius=0 \
  shadow=off \
  padding_left=10 \
  padding_right=10 \
  blur_radius=0

# --- Defaults ------------------------------------------------
sketchybar --default \
  background.drawing=off \
  icon.font="$FONT:Regular:11.0" \
  icon.color=$ICON \
  icon.padding_left=6 \
  icon.padding_right=10 \
  label.font="$FONT:Regular:12.0" \
  label.color=$FG \
  label.padding_left=0 \
  label.padding_right=6 \
  padding_left=4 \
  padding_right=4 \
  y_offset=0

# ============================================================
#  EVENTS
# ============================================================
sketchybar --add event volume_change

# ============================================================
#  LEFT RAIL  (AeroSpace workspaces, left -> right)
# ============================================================
WORKSPACES=(1-uni 2-work 3-resume 4-prep 5-utils 6-bridge 7-oss 8-proj 9-proj-2 10-comms)

for ws in "${WORKSPACES[@]}"; do
  num="${ws%%-*}"
  sketchybar --add item "space.$ws" left \
    --set "space.$ws" \
      icon.drawing=off \
      label="$num" \
      label.font="$FONT:Regular:12.0" \
      label.color=$DIM \
      label.padding_left=7 \
      label.padding_right=7 \
      background.drawing=off \
      background.color=0x00000000 \
      background.corner_radius=7 \
      background.height=20 \
      background.border_width=0 \
      background.border_color=$ICON \
      click_script="aerospace workspace $ws" \
      update_freq=0
done

# --- fullscreen indicator (amber pill, only when active) -----
sketchybar --add item fullscreen left \
  --set fullscreen \
    icon.drawing=off \
    label="FS" \
    label.font="$FONT:Regular:12.0" \
    label.color=$WARN \
    label.padding_left=7 \
    label.padding_right=7 \
    background.drawing=off \
    background.color=0x40e6a94d \
    background.corner_radius=7 \
    background.height=20 \
    background.border_width=1 \
    background.border_color=$WARN \
    update_freq=0 \
    drawing=off

# ============================================================
#  RIGHT RAIL  (left -> right: cpu, ram, volume, battery, datetime)
# ============================================================

# --- helper: separator item ---------------------------------
add_sep() {
  sketchybar --add item "$1" right \
    --set "$1" \
    icon.drawing=off \
    label="||" \
    label.color=$DIM \
    label.font="$FONT:Regular:11.0" \
    label.padding_left=14 \
    label.padding_right=14
}

# -------------------------- DATETIME ------------------------
sketchybar --add item datetime right \
  --set datetime \
  icon.drawing=off \
  script="$PLUGIN_DIR/datetime.sh" \
  update_freq=10

add_sep sep4

# -------------------------- BATTERY -------------------------
# Slim charge bar (slider). Hovering swaps the bar for the exact
# percentage inside the very same slot, so the bar never reflows.
sketchybar --add slider battery right 46 \
  --set battery \
  icon="BAT" \
  slider.percentage=0 \
  slider.highlight_color=$PIP_ACCENT \
  slider.background.color=0x33a98bff \
  slider.background.border_color=0x55a98bff \
  slider.background.border_width=1 \
  slider.background.corner_radius=4 \
  slider.background.height=12 \
  slider.knob.font="$FONT:Regular:12.0" \
  slider.knob.color=$PIP_ACCENT \
  script="$PLUGIN_DIR/battery.sh" \
  update_freq=15
sketchybar --subscribe battery system_woke power_source_change mouse.entered mouse.exited mouse.clicked

add_sep sep3

# --------------------------- VOLUME -------------------------
sketchybar --add item volume right \
  --set volume \
  icon="VOL" \
  script="$PLUGIN_DIR/volume.sh" \
  update_freq=0
sketchybar --subscribe volume volume_change

add_sep sep2

# ---------------------------- RAM ---------------------------
sketchybar --add item ram right \
  --set ram \
  icon="MEM" \
  script="$PLUGIN_DIR/ram.sh" \
  update_freq=2

add_sep sep1

# ---------------------------- CPU ---------------------------
sketchybar --add item cpu right \
  --set cpu \
  icon="CPU" \
  script="$PLUGIN_DIR/cpu.sh" \
  update_freq=2
sketchybar --subscribe cpu system_woke

# ============================================================
#  INITIAL DRAW
# ============================================================
rm -f "${TMPDIR:-/tmp}/sketchybar-battery-hover"

for plugin in cpu ram volume battery datetime; do
  "$PLUGIN_DIR/$plugin.sh" >/dev/null 2>&1 &
done

"$PLUGIN_DIR/aerospace-events.sh" --paint-once >/dev/null 2>&1 &

sketchybar --update
